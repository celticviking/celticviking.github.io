---
// One logbook entry. Astro builds one page per Markdown file in src/content/log/.
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { roomById, roomHref } from '../../data/site';
import { getLog, longDate, excerpt, type LogEntry } from '../../lib/log';

export async function getStaticPaths() {
  const entries = await getLog();
  return entries.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, newer: entries[i - 1], older: entries[i + 1] },
  }));
}

interface Props { entry: LogEntry; newer?: LogEntry; older?: LogEntry }
const { entry, newer, older } = Astro.props;
const { title, date, room, tags, cover, coverAlt, draft } = entry.data;
const r = roomById(room);
const { Content } = await render(entry);
---
<Base title={title} description={excerpt(entry)}>
  <article class="wrap entry">
    <header class="entry-head">
      <p class="mono muted">
        <a href={r.open ? roomHref(r.id) : '/'}>{r.name}</a> · <time datetime={date.toISOString().slice(0, 10)}>{longDate(date)}</time>
        {draft && <span class="draft"> · Draft (not published)</span>}
      </p>
      <h1>{title}</h1>
    </header>
    {cover && <Image class="cover" src={cover} alt={coverAlt ?? ''} widths={[800, 1400]} sizes="(max-width: 860px) 100vw, 760px" />}
    <div class="prose">
      <Content />
    </div>
    {tags.length > 0 && <p class="mono muted tags">{tags.join(' · ')}</p>}
    <nav class="pager mono" aria-label="More entries">
      {older ? <a href={`/log/${older.id}/`}>← {older.data.title}</a> : <span />}
      <a href="/log/">All entries</a>
      {newer ? <a href={`/log/${newer.id}/`}>{newer.data.title} →</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .entry { max-width: calc(760px + 2 * var(--gutter)); padding-top: 80px; padding-bottom: 104px; }
  .entry-head .mono { margin: 0 0 18px; }
  .entry-head .mono a { text-decoration: none; }
  .draft { color: var(--accent); }
  h1 { margin: 0 0 40px; font-family: var(--font-display); font-weight: 600; font-size: clamp(40px, 5vw, 60px); line-height: 1.05; }
  .cover { width: 100%; height: auto; display: block; margin-bottom: 40px; }

  .prose { font-size: 20px; color: var(--text-lead); }
  .prose :global(h2), .prose :global(h3) {
    font-family: var(--font-sc);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.15;
    margin: 1.8em 0 0.5em;
  }
  .prose :global(h2) { font-size: 32px; }
  .prose :global(h3) { font-size: 27px; }
  .prose :global(> :first-child) { margin-top: 0; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 1em; }
  .prose :global(a) { text-underline-offset: 3px; }
  .prose :global(blockquote) { margin: 1.4em 0; padding-left: 20px; border-left: 2px solid var(--accent); font-style: italic; }
  .prose :global(img) { display: block; margin: 1.6em 0; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--rule-soft); margin: 2.4em 0; }

  .tags { margin: 48px 0 0; font-size: 11px; }
  .pager {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 16px;
    font-size: 11px;
  }
  .pager a { text-decoration: none; padding: 8px 0; }
  .pager a:hover { text-decoration: underline; text-underline-offset: 6px; }
  .pager > :last-child { text-align: right; }
  @media (max-width: 640px) {
    .entry { padding-top: 56px; }
    .prose { font-size: 19px; }
    .pager { grid-template-columns: 1fr; }
    .pager > :last-child { text-align: left; }
  }
</style>
