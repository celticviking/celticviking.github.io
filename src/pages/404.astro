---
import Base from '../layouts/Base.astro';
---
<Base title="Not found">
  <div class="wrap page">
    <p class="mono muted">404</p>
    <h1>There’s no room here.</h1>
    <p class="lead">This door doesn’t lead anywhere, or the page has moved. <a href="/">Back to the entry hall →</a></p>
  </div>
</Base>

<style>
  .page { padding-top: 120px; padding-bottom: 160px; }
  .page > * { max-width: 680px; }
  .mono { margin: 0 0 18px; }
  h1 { margin: 0 0 20px; font-family: var(--font-display); font-weight: 600; font-size: clamp(44px, 6vw, 68px); line-height: 1.02; }
  .lead { margin: 0; font-size: 21px; color: var(--text-lead); }
</style>
