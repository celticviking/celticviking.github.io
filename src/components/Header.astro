---
import Mark from './Mark.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site, rooms, roomHref } from '../data/site';

const path = Astro.url.pathname;
const menu = rooms.filter((r) => r.open);
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <Mark class="brand-mark" />
      <span class="brand-name">{site.name}</span>
    </a>
    <nav class="nav mono" aria-label="Rooms">
      <ThemeToggle />
      {menu.map((r) => {
        const href = roomHref(r.id);
        const current = path.startsWith(href);
        return <a href={href} aria-current={current ? 'page' : undefined}>{r.menu}</a>;
      })}
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--rule); }
  .bar {
    padding-top: 18px;
    padding-bottom: 18px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 40px;
  }
  .brand { display: flex; align-items: center; gap: 14px; text-decoration: none; }
  .brand :global(.brand-mark) { color: var(--mark); }
  .brand-name {
    font-family: var(--font-sc);
    font-size: 23px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 28px;
    font-size: 13px;
  }
  .nav a { text-decoration: none; padding: 12px 0; }
  .nav a:hover, .nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; }
  @media (max-width: 640px) {
    .brand-name { font-size: 20px; }
    .nav { gap: 2px 20px; }
  }
</style>
