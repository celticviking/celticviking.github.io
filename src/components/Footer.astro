---
import HandMark from './HandMark.astro';
import { site, elsewhere } from '../data/site';
import { pageText } from '../lib/pages';
// The line next to the mark: src/content/pages/footer.md
const { html: line } = await pageText('footer');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap foot">
    <div class="colophon">
      <HandMark width={40} />
      <div class="line" set:html={line} />
    </div>
    <div class="meta">
      <nav class="mono links" aria-label="Elsewhere">
        {elsewhere.map((l) => (l.url ? <a href={l.url} rel="me noopener">{l.name}</a> : <span>{l.name}</span>))}
      </nav>
      <p class="mono muted small">{site.region} · © {year} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 2px solid var(--rule); }
  :root[data-theme='dark'] .site-footer { border-top: 1px solid var(--wall); }
  .foot {
    padding-top: 48px;
    padding-bottom: 56px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px 56px;
  }
  .colophon { display: flex; align-items: center; gap: 24px; flex: 1 1 420px; max-width: 620px; }
  .line :global(p) { margin: 0; font-size: 17px; color: var(--text-soft); }
  .meta { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .links { display: flex; flex-wrap: wrap; gap: 4px 24px; }
  .links a, .links span { text-decoration: none; padding: 10px 0; }
  .links a:hover { text-decoration: underline; text-underline-offset: 6px; }
  .small { margin: 0; font-size: 11px; }
</style>
