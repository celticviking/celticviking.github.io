---
// The refined VCV mark as an inline SVG. It takes its colour from the
// surrounding text (currentColor), so CSS decides ink, bone or ember.
interface Props { width?: number; height?: number; strokeWidth?: number; class?: string }
const { width = 21, height = 36, strokeWidth = 7, class: cls } = Astro.props;
---
<svg class={cls} viewBox="-2 4 63 110" width={width} height={height} aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
    <path d="M30 10 L30 109" />
    <path d="M30 10 L1.2 43" />
    <path d="M30 10 L58.8 43 L58.8 109" />
    <path d="M30 10 L58.8 43 L30 76 L58.8 109" />
    <path d="M30 76 L15.02 58.84" />
    <path d="M30 76 L15.02 93.16" />
  </g>
</svg>
