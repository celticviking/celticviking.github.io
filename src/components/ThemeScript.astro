---
// Runs in <head> before the page paints, so there is never a flash of the
// wrong theme. It reads the visitor's saved choice, or falls back to their
// system setting. Kept tiny and inline on purpose.
---
<script is:inline>
  (function () {
    var t = null;
    try { t = localStorage.getItem('vcv-theme'); } catch (e) {}
    if (t !== 'light' && t !== 'dark') {
      t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    document.documentElement.setAttribute('data-theme', t);
  })();
</script>
