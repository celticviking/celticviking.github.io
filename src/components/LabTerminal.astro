---
// The thin terminal on /lab/ and each category page: the most recently updated projects.
// Amber phosphor, like the Halcyon Reach OS screens. Always dark, whatever the page's theme. Names link to a project's page when it has one.
import { categoryOf, slugOf, projectUrl, statusText, isoDay, type LabProject } from '../lib/lab';

type P = LabProject & { lastUpdated?: Date };
interface Props {
  projects: P[];                                    // already sorted, newest first
  categories: Record<string, { title: string; accent: string }>;
  path?: string;                                    // shown in the prompt, e.g. "~/lab/apps"
  showCategory?: boolean;
}
const { projects, categories, path = '~/lab', showCategory = true } = Astro.props;
const rows = projects.filter((p) => p.lastUpdated).slice(0, 3);
---
<section class="term" aria-label="Recently updated projects">
  <div class="bar" aria-hidden="true"><span class="dot" /><span class="dot" /><span class="dot" /><span class="title">vahn@lab: {path}</span></div>
  <div class="body">
    <p class="cmd"><span class="ps1">vahn@lab:{path}$</span> ls --recent</p>
    {rows.length === 0 ? (
      <p class="dim">nothing updated yet</p>
    ) : (
      <table>
        <thead>
          <tr>
            <th scope="col">Name</th>
            {showCategory && <th scope="col" class="opt">Category</th>}
            <th scope="col">Status</th>
            <th scope="col" class="opt">Platform</th>
            <th scope="col">Updated</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((p) => {
            const cat = categories[categoryOf(p)];
            return (
              <tr>
                <td class="name">
                  {p.data.page ? <a href={projectUrl(p)} aria-label={p.data.title}>{slugOf(p)}</a> : <span title={p.data.title}>{slugOf(p)}</span>}
                </td>
                {showCategory && <td class="opt" style={cat ? `color:${cat.accent}` : undefined}>{cat?.title.toLowerCase() ?? categoryOf(p)}</td>}
                <td>{statusText(p).toLowerCase()}</td>
                <td class="opt">{p.data.platform || '—'}</td>
                <td><time datetime={isoDay(p.lastUpdated)}><span class="yr">{isoDay(p.lastUpdated).slice(0, 5)}</span>{isoDay(p.lastUpdated).slice(5)}</time></td>
              </tr>
            );
          })}
        </tbody>
      </table>
    )}
    <p class="cmd" aria-hidden="true"><span class="ps1">vahn@lab:{path}$</span> <span class="cursor" /></p>
  </div>
</section>

<style>
  .term {
    --t-bg: #090908;
    --t-text: #f2d49b;
    --t-dim: #a08a62;
    --t-hi: #ffb84a;
    background: var(--t-bg);
    color: var(--t-text);
    border: 1px solid #3a3226;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.6;
    text-align: left;
  }
  .bar { display: flex; align-items: center; gap: 6px; padding: 7px 12px; border-bottom: 1px solid #241f18; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #3a3226; }
  .title { margin-left: 8px; color: var(--t-dim); font-size: 11px; letter-spacing: 0.08em; }
  .body { padding: 12px 16px 14px; overflow-x: auto; }
  .cmd { margin: 0; white-space: nowrap; }
  .ps1 { color: var(--t-hi); }
  .dim { margin: 4px 0; color: var(--t-dim); }
  table { border-collapse: collapse; margin: 6px 0; min-width: 100%; }
  th {
    padding: 2px 28px 4px 0;
    color: var(--t-dim);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px;
    text-align: left;
    white-space: nowrap;
  }
  td { padding: 2px 28px 2px 0; white-space: nowrap; }
  th:last-child, td:last-child { padding-right: 0; }
  .name a { color: var(--t-hi); text-decoration: none; border-bottom: 1px dotted rgba(255, 184, 74, 0.5); }
  .name a:hover { border-bottom-style: solid; }
  .name a:focus-visible { outline: 2px solid var(--t-hi); outline-offset: 2px; }
  .cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--t-hi);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }
  @media (max-width: 640px) {
    .term { font-size: 12px; }
    .body { padding: 10px 12px 12px; }
    .opt, .yr { display: none; }
    th, td { padding-right: 14px; }
  }
</style>
