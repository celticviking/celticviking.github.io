---
// The hand-drawn maker's mark. The PNG is used as a mask, so one image
// can be painted in whatever the current ink colour is (light or dark mode).
interface Props { width: number; label?: string }
const { width, label } = Astro.props;
const height = Math.round(width * 632 / 416);
---
<span
  class="hand-mark"
  style={`width:${width}px;height:${height}px`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
></span>

<style>
  .hand-mark {
    display: block;
    flex: 0 0 auto;
    background: var(--ink);
    -webkit-mask: url('/mark/hand.png') center / contain no-repeat;
    mask: url('/mark/hand.png') center / contain no-repeat;
  }
  /* Windows High Contrast and similar: masks are ignored, so keep a visible box */
  @media (forced-colors: active) {
    .hand-mark { background: CanvasText; }
  }
</style>
