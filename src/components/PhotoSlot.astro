---
// A photo, or, until there is one, a hatched placeholder describing the shot.
// With `zoom` set, the photo links to a larger copy that opens in the full-screen
// viewer (Lightbox.astro); photos sharing a `zoom` name step through together there.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photo?: ImageMetadata;
  alt?: string;
  label: string;
  ratio: string;            // e.g. '16 / 9'
  sizes: string;            // how wide the photo shows, for responsive images
  widths?: number[];
  eager?: boolean;          // true for the first photo on a page
  zoom?: string;            // group name for the full-screen viewer; leave out for no viewer
  caption?: string;         // shown under the photo in the viewer
}
const { photo, alt = '', label, ratio, sizes, widths = [480, 960, 1600], eager = false, zoom, caption } = Astro.props;
const srcWidths = photo ? widths.filter((w) => w <= photo.width).concat(widths.some((w) => w > photo.width) ? [photo.width] : []) : [];
// The larger copy for the viewer: up to 2400px wide, never upscaled.
const full = photo && zoom ? await getImage({ src: photo, width: Math.min(2400, photo.width), format: 'webp' }) : undefined;
---
{photo && full ? (
  <a class="zoom" href={full.src} data-zoom={zoom} data-alt={alt} data-caption={caption} aria-label={alt ? `${alt} (view larger)` : 'View photo larger'}>
    <Image class="slot-photo" src={photo} alt={alt} widths={srcWidths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} style={`aspect-ratio:${ratio}`} />
  </a>
) : photo ? (
  <Image class="slot-photo" src={photo} alt={alt} widths={srcWidths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} style={`aspect-ratio:${ratio}`} />
) : (
  <div class="ph mono" style={`aspect-ratio:${ratio}`} role="img" aria-label={`Photo to come: ${label}`}>[{label}]</div>
)}

<style>
  .slot-photo { display: block; width: 100%; height: auto; object-fit: cover; }
  .zoom { display: block; cursor: zoom-in; }
  .zoom:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
</style>
